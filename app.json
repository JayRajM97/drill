{
  "expo": {
    "name": "Drill",
    "slug": "drill",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "drill",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.aitainment.drill",
      "buildNumber": "1",
      "appleTeamId": "HSVB2Q4W33"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#fbf9f8",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "in.aitainment.drill",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#F3F4F6"
        }
      ],
      "@bacons/apple-targets",
      "expo-audio"
    ],
    "description": "Flashcard-style practice for product management interviews: real case studies broken into cards, plus the numbers every PM should know.",
    "primaryColor": "#1F5EFF"
  }
}
