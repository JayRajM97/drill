rules_version = '2';

// Drill stores one progress document per user at users/{uid}: streak,
// active days, completed drills and bookmarks. Nobody can read or write
// anyone else's — signed in, and only your own uid.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // Drills the user generated, one document each.
      match /drills/{drillId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
